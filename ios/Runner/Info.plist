    <array>
        <string>fetch</string>
        <string>location</string>
        <string>remote-notification</string>
    </array>
    
    <!-- Konum Izinleri -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Yol yardım talebinizi en yakın çekici ve ustalara iletmek için konumunuza ihtiyaç duyarız.</string>
    <key>NSLocationAlwaysUsageDescription</key>
    <string>İşlem devam ederken ustanın size ulaşabilmesi ve yeni iş bildirimleri alabilmeniz için konumunuz arka planda güncellenir.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>İşlem devam ederken ustanın size ulaşabilmesi ve yeni iş bildirimleri alabilmeniz için konumunuz arka planda güncellenir.</string>
    
    <!-- Kamera, Galeri ve Mikrofon Izinleri -->
