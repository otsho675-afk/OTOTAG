    <key>GIDClientID</key>
    <string>73273804842-u0lcirptug9aotm2m6gn27g92hftt5ud.apps.googleusercontent.com</string>

    <!-- Google Sign-In URL Semasi -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>com.googleusercontent.apps.73273804842-u0lcirptug9aotm2m6gn27g92hftt5ud</string>
            </array>
        </dict>
    </array>
    
    <!-- iOS Arka Plan Bildirim & Konum Akisi -->
